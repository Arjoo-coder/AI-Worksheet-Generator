# These map to backend/src/main/resources/application.yml (app.ai.*, app.pdf.*,
# app.cors.*). Export them before running the backend, or set them in your
# IDE's run configuration. NEVER commit real secrets.

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5500

# ---- AI provider: LOCAL OLLAMA (default, no key needed) ----
AI_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
AI_API_KEY=
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=1200
LLM_MAX_CONTENT_CHARS=60000
LLM_MAX_RETRIES=1

# ---- Optional: switch to a hosted OpenAI-compatible provider instead ----
# AI_PROVIDER=openai
# OLLAMA_API_URL=https://api.openai.com/v1/chat/completions
# OLLAMA_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# ---- PDF conversion (LibreOffice headless) ----
# Usually just "soffice" if it's on PATH. Examples:
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   macOS:   /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=soffice
PDF_CONVERSION_TIMEOUT_SECONDS=60
